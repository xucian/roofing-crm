{
  "name": "roofing-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@roofing-crm/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test",
    "synth": "turbo run synth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm synth && pnpm --filter @roofing-crm/pipeline-client check:pin",
    "basemap": "tsx scripts/basemap.ts",
    "deploy:aws": "tsx scripts/deploy.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@roofing-crm/shared": "workspace:*",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jiti": "^2.6.0",
    "prettier": "^3.9.0",
    "tsx": "^4.21.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.1.0"
  }
}
