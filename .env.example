# Local secrets. Copy to .env (gitignored). Never commit real keys.
# Deploy (F5) copies LANGSMITH_API_KEY into Secrets Manager; the Lambda
# receives LANGSMITH_API_KEY_SECRET_ARN, not the key in plaintext env.

# The pipeline API base (API_BASE) is not set here: it is committed configuration,
# `apiBase` in packages/pipeline-client/openapi.pin.json. To point a local run at
# another pipeline, export PIPELINE_API_BASE in the shell.

# Runtime agent name. Fixed. Also the LangSmith project.
LANGSMITH_PROJECT=pidgeot-agent

# From the LangSmith workspace. Required for tracing; chat still works if unset.
LANGSMITH_API_KEY=

# Kit defaults if omitted at F5:
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
